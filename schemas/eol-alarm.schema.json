{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-quality.example/schemas/eol-alarm.schema.json",
  "title": "EOL Test Failure Alarm",
  "description": "Alarm generated when a battery assembly end-of-line test fails.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alarm_id",
    "test_id",
    "detected_at",
    "station_id",
    "module_serial",
    "cell_lot",
    "failure_code",
    "severity",
    "status",
    "title",
    "process_area",
    "measurement_name",
    "measured_value",
    "limit_value",
    "limit_operator",
    "unit",
    "recommendation"
  ],
  "properties": {
    "alarm_id": {
      "type": "string",
      "pattern": "^ALM-T[0-9]+$"
    },
    "test_id": {
      "type": "string",
      "pattern": "^T[0-9]+$"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "station_id": {
      "type": "string",
      "pattern": "^EOL-[0-9]{2}$"
    },
    "module_serial": {
      "type": "string"
    },
    "cell_lot": {
      "type": "string"
    },
    "failure_code": {
      "enum": ["CAP_LOW", "IR_HIGH", "TEMP_HIGH"]
    },
    "severity": {
      "enum": ["MAJOR", "CRITICAL"]
    },
    "status": {
      "const": "ACTIVE"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "process_area": {
      "type": "string",
      "minLength": 1
    },
    "measurement_name": {
      "enum": ["capacity_ah", "internal_resistance_mohm", "temperature_c"]
    },
    "measured_value": {
      "type": "number"
    },
    "limit_value": {
      "type": "number"
    },
    "limit_operator": {
      "enum": [">=", "<="]
    },
    "unit": {
      "enum": ["Ah", "mΩ", "°C"]
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    }
  }
}
